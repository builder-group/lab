{
	"name": "@lab/midimarble-v4",
	"version": "0.0.1",
	"private": true,
	"description": "Offline marble track builder that composes music and renders through Blender",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/lab/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/lab.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"type": "module",
	"scripts": {
		"blender:check": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python blender/tests/check_apply_scene.py",
		"build": "tauri build",
		"build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
		"clean": "shx rm -rf target && shx rm -rf dist && shx rm -rf .tanstack && shx rm -rf .turbo && shx rm -rf node_modules",
		"fixtures:build": "tsx scripts/build-fixtures.ts",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"soundbank:build": "tsx scripts/build-soundbank.ts",
		"start:dev": "tauri dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"ui:build": "pnpm typecheck && vite build",
		"ui:start:dev": "vite dev",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@dimforge/rapier3d-deterministic-compat": "^0.21.0",
		"@tanstack/react-router": "^1.170.46",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.4.0",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tonejs/midi": "^2.0.28",
		"clsx": "^2.1.1",
		"feature-react": "^0.1.1",
		"feature-state": "^0.1.1",
		"lucide-react": "^0.562.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"spessasynth_core": "^4.4.1",
		"tailwind-merge": "^3.7.0",
		"three": "^0.186.1",
		"tuple-result": "^0.1.0",
		"versjon": "^0.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@blgc/config": "^0.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.48",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"shx": "^0.4.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"vitest": "^5.0.5"
	}
}
