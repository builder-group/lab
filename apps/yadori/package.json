{
	"name": "@repo/yadori",
	"version": "0.2.0",
	"private": true,
	"description": "Local portable-home build planner",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/lab/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/lab.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"type": "module",
	"scripts": {
		"build": "tauri build --debug",
		"build:prod": "tauri build",
		"clean": "shx rm -rf src-tauri/target dist .turbo node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"mcp": "node scripts/mcp/index.mjs",
		"model:contract": "tsx scripts/mcp/build-contract.ts",
		"start:dev": "tauri dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"ui:build": "pnpm model:contract && pnpm typecheck && vite build",
		"ui:start:dev": "vite --host 127.0.0.1",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tiptap/extension-placeholder": "3.32.2",
		"@tiptap/extension-task-item": "3.32.2",
		"@tiptap/extension-task-list": "3.32.2",
		"@tiptap/markdown": "3.32.2",
		"@tiptap/pm": "3.32.2",
		"@tiptap/react": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
		"@xyflow/react": "^12.10.0",
		"feature-react": "link:../../../community/packages/feature-react",
		"feature-state": "link:../../../community/packages/feature-state",
		"lucide-react": "^1.62.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"versjon": "0.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@blgc/config": "^0.1.2",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tsx": "^4.23.15",
		"vitest": "^5.0.5"
	}
}
