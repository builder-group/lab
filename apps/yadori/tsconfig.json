{
	"extends": "@blgc/config/typescript/react",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["vite/client", "node"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"],
	"exclude": ["node_modules", "src-tauri", "crates"]
}
