{
	"name": "@repo/kairos",
	"version": "0.0.4",
	"private": true,
	"description": "",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/lab/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/lab.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"main": "expo-router/entry",
	"scripts": {
		"build": "pnpm typecheck && expo export --platform ios --output-dir dist",
		"clean": "shx rm -rf build && shx rm -rf dist && shx rm -rf .expo && shx rm -rf .turbo && shx rm -rf node_modules",
		"expo:doctor": "pnpm dlx expo-doctor@latest",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"install:clean": "pnpm run clean && pnpm install",
		"ios:build:cloud": "pnpm dlx eas-cli@latest build --platform ios --profile production",
		"ios:build:local": "bash ./scripts/ios-eas.sh build",
		"ios:submit:cloud": "pnpm dlx eas-cli@latest submit --platform ios --profile production --latest",
		"ios:submit:local": "bash ./scripts/ios-eas.sh submit",
		"lint": "eslint .",
		"start:dev": "expo start --dev-client --lan",
		"start:dev:ios": "expo start --dev-client --ios --lan",
		"start:dev:ios:prebuild": "expo run:ios --device",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit",
		"update:latest": "bash ./scripts/update-latest.sh",
		"version:bump": "bash ./scripts/version.sh"
	},
	"dependencies": {
		"@expo/ui": "~58.0.24",
		"@expo/vector-icons": "^15.0.2",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"clsx": "^2.1.1",
		"expo": "~58.0.20",
		"expo-blur": "~58.0.5",
		"expo-constants": "~58.0.13",
		"expo-dev-client": "~58.0.16",
		"expo-font": "~58.0.10",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.17",
		"expo-keep-awake": "~58.0.3",
		"expo-linking": "~58.0.14",
		"expo-router": "~58.0.27",
		"expo-splash-screen": "~58.0.11",
		"expo-status-bar": "~58.0.4",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.6",
		"feature-react": "^0.1.1",
		"feature-state": "^0.1.1",
		"nativewind": "5.0.0-rc.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-css": "3.1.0-rc.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/react": "~19.3.0",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.3"
	}
}
