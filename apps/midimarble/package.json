	"scripts": {
		"build": "pnpm typecheck && vite build",
		"clean": "shx rm -rf .output && shx rm -rf .tanstack && shx rm -rf .turbo && shx rm -rf node_modules",
		"generate:examples": "bun src/modules/project/generate-examples.ts",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"start:dev": "vite dev",
		"studio": "bun src/tools/studio.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.21.0",
