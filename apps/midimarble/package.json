		"lucide-react": "^1.31.0",
		"mediabunny": "^1.62.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"spessasynth_core": "^4.4.1",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@blgc/config": "^0.1.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
